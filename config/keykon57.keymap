#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

/ {
    macros {
        shift: with_lshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "KEY_PRESS_WITH_LEFT_SHIFT_MODIFIER";
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AUTOSHIFT_KEYPRESS";
        };
    };

    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            bindings = <&shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ctrl+alt+del {
            bindings = <&kp LA(LC(DEL))>;
            key-positions = <25 27 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC    &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_N5  &kp DE_N6  &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp DE_N0   &kp DEL
&kp TAB    &kp DE_Q   &kp DE_W   &kp DE_E   &kp DE_R   &kp DE_T   &kp DE_Z   &kp DE_U   &kp DE_I   &kp DE_O   &kp DE_P    &kp RET
&kp LCTRL  &kp DE_A   &kp DE_S   &kp DE_D   &kp DE_F   &kp DE_G   &kp DE_H   &kp DE_J   &kp DE_K   &kp DE_L   &kp DE_SQT
&kp LSHFT  &kp DE_Y   &kp DE_X   &kp DE_C   &kp DE_V   &kp DE_B   &kp DE_N   &kp DE_M   &kp COMMA  &kp DOT    &kp UP      &kp RSHFT
&kp RALT   &kp LGUI   &kp LALT   &mo 2      &kp SPACE             &mo 1      &kp BSPC              &kp LEFT   &kp DOWN    &kp RIGHT
            >;
        };

        symbol {
            bindings = <
&trans  &trans           &trans     &trans  &trans  &trans       &trans       &trans           &trans        &trans           &trans        &trans
&trans  &trans           &trans     &trans  &trans  &kp DE_LBRC  &kp DE_RBRC  &kp DE_U_UMLAUT  &kp DE_CARET  &kp DE_O_UMLAUT  &kp DE_BSLH   &trans
&trans  &kp DE_A_UMLAUT  &kp DE_SZ  &trans  &trans  &kp DE_LPAR  &kp DE_RPAR  &kp DE_ACUTE     &kp DE_LT     &kp DE_PLUS      &kp DE_HASH
&trans  &trans           &trans     &trans  &trans  &kp DE_LBKT  &kp DE_RBKT  &kp DE_PIPE      &kp DE_GT     &kp DE_ASTRK     &kp DE_MINUS  &trans
&trans  &trans           &trans     &trans  &trans               &trans       &trans                         &trans           &trans        &trans
            >;
        };

        mods {
            bindings = <
&trans      &kp F1    &kp F2     &kp F3     &kp F4     &kp F5   &kp F6   &kp F7     &kp F8     &kp F9    &kp F10          &trans
&trans      &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp F11  &kp F12  &kp INS    &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK  &trans
&caps_word  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans   &trans   &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans      &trans    &trans     &trans     &trans     &trans   &trans   &trans     &trans     &trans    &trans           &trans
&trans      &trans    &trans     &trans     &trans              &trans   &trans                &trans    &trans           &trans
            >;
        };

        konfig {
            bindings = <
&sys_reset      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &none   &none  &none   &none   &bt BT_CLR
&none           &none         &none         &none         &none         &none         &none   &none   &none  &none   &none   &bootloader
&studio_unlock  &none         &none         &none         &none         &none         &none   &none   &none  &none   &none
&trans          &none         &none         &none         &none         &none         &none   &none   &none  &none   &trans  &trans
&trans          &trans        &trans        &trans        &trans                      &trans  &trans         &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        konfig {
            if-layers = <3 3>;
            then-layer = <3>;
        };
    };
};
