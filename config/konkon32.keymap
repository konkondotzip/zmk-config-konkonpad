#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        shift: with_lshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "KEY_PRESS_WITH_LEFT_SHIFT_MODIFIER";
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AUTOSHIFT_KEYPRESS";
        };
    };

    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            bindings = <&shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <20 21>;
        };

        ctrl+alt+del {
            bindings = <&kp LA(LC(DEL))>;
            key-positions = <10 12 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G        &kp H        &kp J  &kp K      &kp L    &kp BACKSPACE
&kp Z  &kp X  &kp C  &kp V  &kp B        &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
                            &lt 1 SPACE  &lt 2 ENTER
            >;
        };

        symbol {
            bindings = <
&kp RA(Q)         &kp RA(MINUS)  &kp RA(E)  &none      &kp RA(N8)  &kp RA(N9)  &kp LBKT   &kp RA(NUBS)  &kp SEMI  &kp RA(RBKT)
&kp SINGLE_QUOTE  &kp MINUS      &none      &kp GRAVE  &kp RA(N7)  &kp RA(N0)  &kp EQUAL  &kp NUBS      &kp RBKT  &kp NUHS
&kp N1            &kp N2         &kp N3     &kp N4     &kp N5      &kp N6      &kp N7     &kp N8        &kp N9    &kp N0
                                                       &trans      &trans
            >;
        };

        mods {
            bindings = <
&kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &caps_word  &kp INS  &kp PRINTSCREEN  &kp PAUSE_BREAK  &sk RALT  &sk LGUI
&kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp F11     &kp F12  &sk LSHFT        &sk LCTRL        &sk LALT  &kp DEL
&kp F1    &kp F2     &kp F3     &kp F4     &kp F5      &kp F6   &kp F7           &kp F8           &kp F9    &kp F10
                                           &trans      &trans
            >;
        };

        konfig {
            bindings = <
&studio_unlock  &none         &none         &none         &none         &none   &none  &none  &none  &bootloader
&none           &none         &none         &none         &none         &none   &none  &none  &none  &sys_reset
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &none  &none  &none  &bt BT_CLR
                                                          &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        konfig {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
