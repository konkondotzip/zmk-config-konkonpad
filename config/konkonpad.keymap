#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp ESC         &kp KP_N7   &kp KP_N8   &kp KP_N9
        &kp TAB         &kp KP_N4   &kp KP_N5   &kp KP_N6
        &kp BSPC        &kp KP_N1   &kp KP_N2   &kp KP_N3
        &lt 1 KP_NUM    &kp KP_N0   &kp KP_DOT  &kp KP_ENTER
      >;
    };

    bt_layer {
      bindings = <
      &studio_unlock  &none           &none           &none
      &none           &none           &none           &none
      &bt BT_CLR      &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3
      &trans          &none           &none           &bootloader
      >;
    };
  };
};